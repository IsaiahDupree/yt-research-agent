# YouTube Data API v3 — required for live runs
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# LLM provider — Anthropic preferred; OpenAI as fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Reddit — optional, for subreddit acceleration signal
# https://www.reddit.com/prefs/apps (script-type app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=yt-research-agent/0.1 by your-username

# Cache directory (defaults to .cache/)
YTR_CACHE_DIR=.cache
